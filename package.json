{
  "name": "iron-heart-strength",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "node server/index.mjs",
    "dev:ai": "node --env-file=.env.ai.local server/index.mjs --lan-preview",
    "build": "vite build",
    "start": "node server/index.mjs --production",
    "test": "node --test tests/*.test.mjs",
    "android:sync": "node scripts/check-android.mjs && pnpm build && cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "vite": "^7.0.0"
  }
}
